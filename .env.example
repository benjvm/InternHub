VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
VITE_CLOUDINARY_PROFILE_FOLDER=internhub/profile-images

VITE_CLOUDINARY_CV_UPLOAD_PRESET=your_unsigned_pdf_upload_preset
VITE_CLOUDINARY_CV_FOLDER=internhub/student-cvs
VITE_OPENROUTER_API_KEY=miApiKey
VITE_OPENROUTER_MODEL=qwen/qwen3.6-plus
VITE_OPENROUTER_SITE_URL=http://localhost:5173
VITE_OPENROUTER_APP_NAME=InternHub

# Supabase client credentials:
# VITE_SUPABASE_URL: Project URL from Supabase > Project Settings > API.
# VITE_SUPABASE_ANON_KEY: anon public key from Supabase > Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY: service_role key for local migration scripts only. Never expose it in Vite/client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend selector during migration:
# firebase keeps the current Firebase backend.
# supabase switches auth/database services to Supabase when the keys above exist.
VITE_DATA_BACKEND=firebase

VITE_PUBLIC_FIREBASE_API_KEY=miApiKey
VITE_PUBLIC_FIREBASE_AUTH_DOMAIN=authDomain
VITE_PUBLIC_FIREBASE_PROJECT_ID=projectId
VITE_PUBLIC_FIREBASE_STORAGE_BUCKET=storageBucket
VITE_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=senderId
VITE_PUBLIC_FIREBASE_APP_ID=appId
VITE_PUBLIC_FIREBASE_MEASUREMENT_ID=measurementId
